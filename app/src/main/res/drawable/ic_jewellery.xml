<?xml version="1.0" encoding="utf-8"?>
<!--
  RFID chip icon — represents an RFID inlay/tag.
  Design: a rounded rectangular chip body with an antenna coil pattern
  radiating outward, evoking a passive UHF RFID tag. 24dp square,
  colored via android:tint at usage sites (like the other ic_*.xml icons).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Chip body: rounded rectangle representing the RFID silicon -->
    <path
        android:fillColor="#000000"
        android:pathData="M9,10 L15,10 A1,1 0 0 1 16,11 L16,13 A1,1 0 0 1 15,14 L9,14 A1,1 0 0 1 8,13 L8,11 A1,1 0 0 1 9,10 Z" />

    <!-- Contact dots on the chip -->
    <path
        android:fillColor="#000000"
        android:pathData="M10,11.5 L10.8,11.5 L10.8,12.5 L10,12.5 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M13.2,11.5 L14,11.5 L14,12.5 L13.2,12.5 Z" />

    <!-- Antenna coils: three concentric arcs radiating from the chip.
         Outer arc, middle arc, inner arc — evokes a broadcasting RFID signal. -->
    <!-- Inner arc (left) -->
    <path
        android:fillColor="#000000"
        android:pathData="M7.5,9.5 A3,3 0 0 0 7.5,14.5 L8.2,13.8 A2,2 0 0 1 8.2,10.2 Z" />
    <!-- Inner arc (right) -->
    <path
        android:fillColor="#000000"
        android:pathData="M16.5,9.5 A3,3 0 0 1 16.5,14.5 L15.8,13.8 A2,2 0 0 0 15.8,10.2 Z" />

    <!-- Middle arc (left) -->
    <path
        android:fillColor="#000000"
        android:pathData="M5.5,7.5 A5,5 0 0 0 5.5,16.5 L6.2,15.8 A4,4 0 0 1 6.2,8.2 Z" />
    <!-- Middle arc (right) -->
    <path
        android:fillColor="#000000"
        android:pathData="M18.5,7.5 A5,5 0 0 1 18.5,16.5 L17.8,15.8 A4,4 0 0 0 17.8,8.2 Z" />

    <!-- Outer arc (left) -->
    <path
        android:fillColor="#000000"
        android:pathData="M3.5,5.5 A7,7 0 0 0 3.5,18.5 L4.2,17.8 A6,6 0 0 1 4.2,6.2 Z" />
    <!-- Outer arc (right) -->
    <path
        android:fillColor="#000000"
        android:pathData="M20.5,5.5 A7,7 0 0 1 20.5,18.5 L19.8,17.8 A6,6 0 0 0 19.8,6.2 Z" />
</vector>