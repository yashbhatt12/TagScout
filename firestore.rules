rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        // ── User profile: written by the server (snaAdmin.js, team functions) ──
        match /users/{userId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow write: if false;
        }

        // ── Shop catalog (top-level, managed by SNA) ─────────────────
        match /products/{productId} {
            allow read: if request.auth != null;
            allow write: if false;
        }

        // ── Shop orders ──────────────────────────────────────────────
        match /purchase_requisitions/{orderId} {
            allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
            allow read: if request.auth != null && resource.data.userId == request.auth.uid;
            allow update, delete: if false;
        }

        // ── Vertical / type templates: read only by Cloud Functions (Admin SDK) ──
        match /vertical_templates/{templateId} {
            allow read, write: if false;
        }

        // ── Company data: /companies/{companyId}/... ─────────────────
        // A login belongs to a company when its custom claims say so:
        // { companyId, role }, set only by the server (snaAdmin.js, the team
        // functions, the signup trigger).
        //
        // Everyone in the company can read its data. Writes go through the
        // server's functions (functions/src: enrollUnitsV1, changeUnitStatusV1,
        // markSoldV1, updateUnitDetailsV1, locationsV1, catalogV1, productsV1,
        // batchesV1, bumpGrnCounterV1, commitCycleCountV1, team functions), which
        // check roles and business rules and use the Admin SDK. The only direct
        // writes left are the two below.
        match /companies/{companyId} {

            function isMember() {
                return request.auth != null
                    && request.auth.token.get('companyId', '') == companyId;
            }

            allow read: if isMember();
            allow write: if false;

            // Firestore allows a request if ANY matching rule does, so the
            // server-only duplicate-protection records (ops) are excluded here.
            match /{collection}/{document=**} {
                allow read: if isMember() && collection != 'ops';
                allow write: if false;
            }

            // Alerts: created by alarmNotifier; the app may only mark them read.
            match /alerts/{alertId} {
                allow update: if isMember()
                    && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['read', 'readAt', 'readBy']);
            }

            // Door-reader events from the edge service: added, never changed.
            match /tag_events/{eventId} {
                allow create: if isMember();
            }
        }

        // ── Everything else is closed ────────────────────────────────
        match /{document=**} {
            allow read, write: if false;
        }
    }
}