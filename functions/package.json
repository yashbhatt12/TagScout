{
  "name": "functions",
  "description": "Cloud Functions for TagScout (all functions, one codebase)",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions --project tagscout-in",
    "logs": "firebase functions:log --project tagscout-in"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "private": true
}
