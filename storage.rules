rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same membership test as firestore.rules: the login's custom claims
    // must name this company.
    function isMember(companyId) {
      return request.auth != null
        && request.auth.token.get('companyId', '') == companyId;
    }

    // One folder per company: companies/{companyId}/...
    match /companies/{companyId}/{allPaths=**} {
      allow read: if isMember(companyId);

      // Images only, under 2 MB (the app compresses to ~200–400 KB).
      allow create, update: if isMember(companyId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isMember(companyId);
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}