rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Same membership test as firestore.rules: the login's custom claims
    // must name this company.
    function isMember(companyId) {
      return request.auth != null
        && request.auth.token.get('companyId', '') == companyId;
    }

    // Product photos are part of set-up: owners and managers only.
    function canSetUp(companyId) {
      return isMember(companyId)
        && request.auth.token.get('role', '') in ['owner', 'manager'];
    }

    // One folder per company: companies/{companyId}/...
    match /companies/{companyId}/{allPaths=**} {
      allow read: if isMember(companyId);

      // Images only, under 2 MB (the app compresses to ~200–400 KB).
      allow create, update: if canSetUp(companyId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if canSetUp(companyId);
    }

    // GRN Excel files: anyone in the team uploads to their own folder; the server
    // (grnImportV1) reads, checks and then deletes them.
    match /companies/{companyId}/imports/{uid}/{fileName} {
      allow create: if isMember(companyId)
        && request.auth.uid == uid
        && fileName.matches('.*[.]xlsx')
        && request.resource.size < 10 * 1024 * 1024;
      allow read, delete: if isMember(companyId) && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}